{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "stp/bento",
  "title": "Bento",
  "category": "theme",
  "icon": "grid-view",
  "keywords": ["bento", "hub", "actions", "explication", "campagne"],
  "description": "Grille bento explicative : enjeux de la campagne et liens vers les actions.",
  "textdomain": "sage",
  "attributes": {
    "sectionTitle": {
      "type": "string",
      "default": "Pourquoi ce combat ?"
    },
    "items": {
      "type": "array",
      "default": []
    }
  },
  "supports": {
    "html": false,
    "multiple": true,
    "reusable": true
  },
  "render": "file:./render.php"
}
